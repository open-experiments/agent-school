# OpenAI-compatible endpoint: vLLM on RHOAI, MaaS, or local llama.cpp
# (see shared/manifests/vllm-rhoai.md for all options)
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=your-key
LLM_MODEL=your-model-name

# Local dev example with llama.cpp:
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=none
# LLM_MODEL=qwen2.5-7b-instruct

# Rome sandbox example (RHOAI 3.5 EA2, Kimi-Linear on 2x RTX 4090D; QA-verified):
# LLM_BASE_URL=https://kimi-linear-48b-a3b-telco-aix.apps.rome.narlabs.io/v1
# LLM_API_KEY=none
# LLM_MODEL=kimi-linear-48b-a3b

# RHOAI Model-as-a-Service example (LiteLLM gateway; QA-verified):
# LLM_BASE_URL=https://litellm-litemaas.apps.prod.rhoai.rh-aiservices-bu.com/v1
# LLM_API_KEY=sk-...   # keys start with sk-
# LLM_MODEL=Qwen3.6-35B-A3B

# Endpoints behind a self-signed cert (e.g. default OpenShift router):
# point LLM_CA_BUNDLE at a PEM with the route's cert chain instead of
# disabling verification. Extract it with:
#   openssl s_client -showcerts -connect <route-host>:443 </dev/null \
#     | awk '/BEGIN CERT/,/END CERT/' > router-ca.pem
# LLM_CA_BUNDLE=router-ca.pem

# Venice classroom example (RHOAI 3.5 EA2, Kimi-Linear; QA-verified —
# token distributed in class, never committed):
# LLM_BASE_URL=https://kimi-linear-48b-a3b-telco-aix.apps.venice.narlabs.io/v1
# LLM_API_KEY=<service-account token, distributed out-of-band>
# LLM_MODEL=kimi-linear-48b-a3b
# LLM_CA_BUNDLE=venice-router-ca.pem   # checked in; public router cert

# Optional: mirror agent traces to MLflow (populates the RHOAI Experiments tab)
# MLFLOW_TRACKING_URI=http://localhost:5000
#
# On RHOAI 3.x the managed MLflow is workspace-scoped: set MLFLOW_WORKSPACE to
# your data science project and the agent adds the X-MLFLOW-WORKSPACE header
# plus a Bearer token (MLFLOW_TRACKING_TOKEN, or the pod ServiceAccount token
# when running in-cluster). See deploy/ocp/rome for the wired-up overlay.
# MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443/mlflow
# MLFLOW_WORKSPACE=agent-school
# MLFLOW_EXPERIMENT=101-noc-assistant
