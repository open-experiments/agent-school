# Model endpoint (OpenAI-compatible): RHOAI MaaS, vLLM, llama.cpp
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=your-key
# Tier-2 routing: small model investigates, large model writes.
# With one model available, set both to the same id.
LLM_MODEL_SMALL=your-small-model
LLM_MODEL_LARGE=your-large-model

# RAG service backend (pattern 2)
RAG_URL=http://127.0.0.1:8201

# Optional knobs
# RCA_MAX_TURNS=6              # phase-1 investigation budget (tool turns)
# RCA_REPORT_MAX_TOKENS=1200   # phase-2 report budget
# RCA_DISABLE_THINKING=1       # disable Qwen hybrid reasoning for the write-up
# LLM_WIRE_LOG=QA/my_wire.jsonl  # wire-level capture for QA (see QA/)

# Optional: mirror agent traces to MLflow (populates the RHOAI Experiments tab).
# On RHOAI the managed MLflow is workspace-scoped; MLFLOW_WORKSPACE enables the
# X-MLFLOW-WORKSPACE header + ServiceAccount-token auth (see agent/_enable_mlflow
# and deploy/ocp/rome).
# MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443/mlflow
# MLFLOW_WORKSPACE=agent-school
# MLFLOW_EXPERIMENT=201-rca-investigator
